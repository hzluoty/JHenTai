// JHenTai Rust 版主窗口：底部导航 + 画廊列表 + 详情。
// 组件拆分遵循计划 §4.3：每页一个组件 + controller，单 Window + Rust 侧 Navigator。

import { AboutSlint, Button, ScrollView, ListView, VerticalBox, HorizontalBox, LineEdit, StandardListView } from "std-widgets.slint";

export struct GalleryItem {
    gid: int,
    title: string,
    category: string,
    cover: image,
    page-count: int,
    rating: float,
    uploader: string,
    publish-time: string,
    language: string,
    favorite-color: color,
    has-rated: bool,
}

export struct ThumbnailItem {
    index: int,
    thumb: image,
    href: string,
    offset: float,
    is-large: bool,
}

export struct DownloadItem {
    gid: int,
    title: string,
    downloaded: int,
    total: int,
    status: int, // 0 未下载 1 下载中 2 已完成 3 失败
    ratio: float,
}

export struct LoadState {
    loading: bool,
    error: string,
    prev-gid: string,
    next-gid: string,
    total: string,
}

// 单张卡片：列表模式
component GalleryCard inherits Rectangle {
    in property <GalleryItem> item;
    callback clicked();

    height: 96px;
    border-radius: 12px;
    background: Theme.card;
    clip: true;

    HorizontalLayout {
        padding: 8px;
        spacing: 10px;

        // 封面：保持 3:4 比例，懒加载由 Rust 侧按可见范围喂图
        Rectangle {
            width: 60px;
            border-radius: 6px;
            background: Theme.placeholder;
            clip: true;
            Image {
                source: root.item.cover;
                width: 60px;
                height: 100%;
                image-fit: cover;
            }
        }

        VerticalLayout {
            spacing: 4px;
            alignment: start;

            Text {
                text: root.item.title;
                color: Theme.fg;
                font-size: 14px;
                wrap: word-wrap;
                // 两行后省略末尾（不要用 max-height + elide，会只显示最后一行）
                max-lines: 2;
                overflow: elide;
            }

            HorizontalLayout {
                spacing: 6px;
                Rectangle {
                    width: category-text.preferred-width + 10px;
                    height: 18px;
                    border-radius: 4px;
                    background: root.item.favorite-color;
                    category-text := Text {
                        text: root.item.category;
                        color: #ffffff;
                        font-size: 11px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Text {
                    text: root.item.page-count > 0 ? root.item.page-count + "P" : "";
                    color: Theme.fg-dim;
                    font-size: 11px;
                }
                Text {
                    text: root.item.rating > 0 ? "★ " + Math.round(root.item.rating * 10) / 10 : "";
                    color: Theme.star;
                    font-size: 11px;
                }
            }

            Text {
                text: root.item.uploader;
                color: Theme.fg-dim;
                font-size: 11px;
                overflow: elide;
            }
        }
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

export global Theme {
    in-out property <color> bg: #16161a;
    in-out property <color> card: #232329;
    in-out property <color> fg: #ececf1;
    in-out property <color> fg-dim: #9a9aa5;
    in-out property <color> accent: #6750a4;
    in-out property <color> star: #fcb417;
    in-out property <color> placeholder: #33333c;
    in-out property <color> danger: #e5484d;
}

export component AppWindow inherits Window {
    // 默认给状态栏留位（Android 上 Slint 不自动 inset），否则顶栏按钮会被状态栏吞掉点击
    in-out property <length> safe-area-top: 24px;
    // 底部手势区也给一点内边距，否则阅读器工具条按钮点不到
    in-out property <length> safe-area-bottom: 48px;

    title: "JHenTai";
    background: Theme.bg;
    preferred-width: 400px;
    preferred-height: 800px;

    // ---- data exposed to Rust ----
    in-out property <[GalleryItem]> galleries: [];
    in-out property <bool> loading: false;
    in-out property <string> error-text: "";
    in-out property <string> total-text: "";
    in-out property <int> current-tab: 0;
    in-out property <bool> can-go-next: false;
    in-out property <bool> can-go-prev: false;
    in-out property <int> page-index: 0;
    in-out property <bool> has-items: galleries.length > 0;

    // ---- details page ----
    in-out property <int> page: 0; // 0 = list, 1 = details
    in-out property <[ThumbnailItem]> detail-thumbnails: [];
    in-out property <[string]> detail-tags: [];
    in-out property <[string]> detail-comments: [];
    in-out property <string> detail-title: "";
    in-out property <string> detail-japanese-title: "";
    in-out property <string> detail-category: "";
    in-out property <color> detail-category-color: Theme.placeholder;
    in-out property <int> detail-pages: 0;
    in-out property <float> detail-rating: 0;
    in-out property <float> detail-real-rating: 0;
    in-out property <int> detail-rating-count: 0;
    in-out property <int> detail-thumbnail-pages: 0;
    in-out property <string> detail-uploader: "";
    in-out property <string> detail-publish-time: "";
    in-out property <string> detail-size: "";
    in-out property <string> detail-language: "";
    in-out property <bool> detail-is-favorite: false;
    in-out property <bool> detail-expunged: false;
    in-out property <bool> detail-loading: false;
    in-out property <string> detail-error: "";

    // ---- reader page ----
    in-out property <image> reader-current;
    in-out property <int> reader-index: 0;
    in-out property <int> reader-total: 0;
    in-out property <string> reader-error: "";

    // ---- downloads page ----
    in-out property <[DownloadItem]> downloads: [];

    // ---- settings page ----
    in-out property <bool> setting-is-ex: false;
    in-out property <string> setting-proxy-address: "";
    in-out property <string> setting-proxy-type: "system";
    in-out property <bool> setting-domain-fronting: false;
    in-out property <string> setting-read-direction: "Vertical";
    in-out property <bool> setting-auto-turn: false;
    in-out property <string> setting-auto-interval: "2s";
    callback toggle-auto-turn();
    callback cycle-auto-interval();
    in-out property <bool> setting-keep-awake: true;
    in-out property <int> setting-download-concurrency: 3;
    in-out property <bool> setting-download-original: false;
    in-out property <bool> setting-pin-enabled: false;
    in-out property <bool> setting-persistent: true;
    in-out property <string> setting-version: "";
    in-out property <bool> locked: false;
    in-out property <string> account-name: "";
    in-out property <bool> account-logged-in: false;
    in-out property <string> account-status: "";
    in-out property <string> account-user: "";
    in-out property <string> setting-language: "en_US";
    in-out property <[string]> tab-titles: ["Front Page", "Popular", "Ranklist", "Favorites", "Watched", "History"];
    in-out property <string> ui-read: "Read";
    in-out property <string> ui-download: "Download";
    in-out property <string> ui-back: "Back";
    in-out property <string> ui-tags: "Tags";
    in-out property <string> ui-comments: "Comments";
    in-out property <string> ui-about: "About";
    in-out property <string> ui-settings: "Settings";
    in-out property <string> ui-language: "Language";
    in-out property <string> ui-loading: "Loading…";
    in-out property <string> ui-retry: "Retry";
    in-out property <string> ui-no-galleries: "No galleries";
    in-out property <string> ui-no-downloads: "No downloads yet";
    in-out property <string> ui-thumbnails: "Thumbnails";
    in-out property <string> ui-sign-in: "Sign in";
    in-out property <string> ui-sign-out: "Sign out";
    in-out property <string> ui-expunged: "EXPUNGED";
    in-out property <string> ui-total-items: "items";
    in-out property <string> ui-history-local: "History comes from the local database";
    in-out property <string> search-text: "";
    in-out property <bool> searching: false;
    in-out property <[string]> search-history: [];
    callback search(string);
    callback clear-search();
    callback pick-history(int);
    callback cycle-language();
    in-out property <string> account-password: "";
    callback set-account-user(string);
    callback set-account-password(string);

    // ---- callbacks to Rust ----
    callback login(string, string);
    callback logout();
    callback import-cookies(string);
    callback toggle-site();
    callback set-proxy(string);
    callback toggle-domain-fronting();
    callback cycle-read-direction();
    callback toggle-keep-awake();
    callback bump-download-concurrency();
    callback toggle-download-original();
    callback set-pin(string);
    callback unlock(string);
    callback open-settings();
    callback download();
    callback open-downloads();
    callback open-local-gallery(int);
    callback reader-step(int);
    callback save-image();
    callback share-image();
    callback open-reader();
    callback back();
    callback refresh();
    callback next-page();
    callback prev-page();
    callback open-gallery(int);
    callback select-tab(int);

    VerticalBox {
        // 顶栏
        Rectangle {
            height: 52px + safe-area-top;
            background: Theme.card;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: safe-area-top;
                alignment: space-between;

                if page != 0 : Button {
                    text: "‹ " + ui-back;
                    clicked => { root.back(); }
                }
                if page == 2 : Button { text: "save"; clicked => { root.save-image(); } }
                if page == 2 : Button { text: "share"; clicked => { root.share-image(); } }
                if page == 0 : Text {
                    // 搜索时标题显示实际数据源，避免"在 Popular 页看到搜索结果的标题"
                    text: searching ? ("Search: " + search-text) : tab-titles[current-tab];
                    color: Theme.fg;
                    font-size: 18px;
                    font-weight: 600;
                    vertical-alignment: center;
                }

                HorizontalLayout {
                    spacing: 8px;
                    if page == 0 : Text {
                        text: total-text;
                        color: Theme.fg-dim;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    if page == 0 : Button {
                        text: "⇩";
                        clicked => { root.open-downloads(); }
                    }
                    if page == 0 : Button {
                        text: "≡";
                        clicked => { root.open-settings(); }
                    }
                    if page == 0 : Button {
                        text: "↻";
                        clicked => { root.refresh(); }
                    }
                }
            }
        }

        // 搜索栏（仅列表页）
        if page == 0 : Rectangle {
            height: search-history.length > 0 && !searching ? 84px : 52px;
            background: Theme.bg;
            VerticalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 6px;
                spacing: 6px;
                HorizontalLayout {
                    spacing: 8px;
                    LineEdit {
                        text: search-text;
                        placeholder-text: "search keyword / tags";
                        edited(text) => { root.search-text = text; }
                        accepted(text) => { root.search(text); }
                    }
                    Button {
                        text: searching ? "✕" : "🔍";
                        clicked => {
                            if (root.searching) { root.clear-search(); }
                            else { root.search(root.search-text); }
                        }
                    }
                }
                if search-history.length > 0 && !searching : HorizontalLayout {
                    spacing: 6px;
                    for item[index] in search-history : Button {
                        text: item;
                        clicked => { root.pick-history(index); }
                    }
                }
            }
        }

        // 列表区（仅列表页）
        if page == 0 && !has-items : Rectangle {
            VerticalLayout {
                alignment: center;
                spacing: 12px;

                if loading : Text {
                    text: ui-loading;
                    color: Theme.fg-dim;
                    horizontal-alignment: center;
                }

                if !loading && error-text != "" : VerticalLayout {
                    spacing: 12px;
                    Text {
                        text: error-text;
                        color: Theme.danger;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    Button {
                        text: ui-retry;
                        clicked => { root.refresh(); }
                    }
                }

                if !loading && error-text == "" : Text {
                    text: ui-no-galleries;
                    color: Theme.fg-dim;
                    horizontal-alignment: center;
                }
            }
        }

        if page == 0 && has-items : ListView {
            for gallery[index] in galleries : GalleryCard {
                item: gallery;
                clicked => { root.open-gallery(index); }
            }
        }

        // 详情页（page 1）
        if page == 1 : ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 10px;
                padding: 12px;

                if detail-loading : Text {
                    text: ui-loading;
                    color: Theme.fg-dim;
                    horizontal-alignment: center;
                }

                if !detail-loading && detail-error != "" : Text {
                    text: detail-error;
                    color: Theme.danger;
                    wrap: word-wrap;
                }

                if !detail-loading && detail-error == "" : VerticalLayout {
                    spacing: 8px;

                    Text {
                        text: detail-title;
                        color: Theme.fg;
                        font-size: 18px;
                        font-weight: 600;
                        wrap: word-wrap;
                    }
                    if detail-japanese-title != "" : Text {
                        text: detail-japanese-title;
                        color: Theme.fg-dim;
                        font-size: 13px;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            width: detail-category-text.preferred-width + 12px;
                            height: 20px;
                            border-radius: 4px;
                            background: detail-category-color;
                            detail-category-text := Text {
                                text: detail-category;
                                color: #ffffff;
                                font-size: 12px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Text { text: detail-pages + "P"; color: Theme.fg-dim; font-size: 12px; vertical-alignment: center; }
                        Text {
                            text: "★ " + Math.round(detail-rating * 10) / 10 + " (" + detail-rating-count + ")";
                            color: Theme.star;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        if detail-expunged : Text {
                            text: ui-expunged;
                            color: Theme.danger;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: (detail-uploader == "" ? "unknown" : detail-uploader)
                            + " · " + detail-language + " · " + detail-size + " · " + detail-publish-time;
                        color: Theme.fg-dim;
                        font-size: 12px;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Button {
                            text: ui-read + " (" + detail-pages + ")";
                            clicked => { root.open-reader(); }
                        }
                        Button {
                            text: ui-download;
                            clicked => { root.download(); }
                        }
                    }

                    Text { text: ui-tags; color: Theme.fg; font-size: 14px; font-weight: 600; }
                    for tag-line in detail-tags : Text {
                        text: tag-line;
                        color: Theme.fg-dim;
                        font-size: 12px;
                        wrap: word-wrap;
                    }

                    Text {
                        text: ui-thumbnails + " (" + detail-thumbnail-pages + ")";
                        color: Theme.fg;
                        font-size: 14px;
                        font-weight: 600;
                    }
                    GridLayout {
                        spacing: 8px;
                        for thumb[index] in detail-thumbnails : Rectangle {
                            row: Math.floor(index / 5);
                            col: Math.mod(index, 5);
                            min-width: 48px;
                            min-height: 64px;
                            border-radius: 4px;
                            background: Theme.placeholder;
                            clip: true;
                            Image {
                                source: thumb.thumb;
                                width: 100%;
                                height: 100%;
                                image-fit: cover;
                            }
                        }
                    }

                    if detail-comments.length > 0 : Text {
                        text: ui-comments;
                        color: Theme.fg;
                        font-size: 14px;
                        font-weight: 600;
                    }
                    for comment in detail-comments : Text {
                        text: comment;
                        color: Theme.fg-dim;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }
        }

        // 设置页（page 4）
        if page == 4 : ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 10px;
                padding: 12px;

                Text { text: "Account & Site"; color: Theme.fg; font-size: 13px; font-weight: 600; }
                Rectangle {
                    height: 176px;
                    border-radius: 10px; background: Theme.card;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;
                        Text {
                            text: account-logged-in ? ("Signed in as " + account-name) : "Not signed in (EX & original images need login)";
                            color: account-logged-in ? Theme.fg : Theme.fg-dim;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        if !account-logged-in : LineEdit {
                            placeholder-text: "username / email";
                            edited(text) => { root.set-account-user(text); }
                        }
                        if !account-logged-in : LineEdit {
                            input-type: password;
                            placeholder-text: "password";
                            edited(text) => { root.set-account-password(text); }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            if !account-logged-in : Button {
                                text: ui-sign-in;
                                clicked => { root.login(root.account-user, root.account-password); }
                            }
                            if account-logged-in : Button {
                                text: ui-sign-out;
                                clicked => { root.logout(); }
                            }
                            Text {
                                text: account-status;
                                color: Theme.fg-dim;
                                font-size: 11px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }
                Rectangle {
                    height: 48px; border-radius: 10px; background: Theme.card;
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px;
                        spacing: 12px;
                        Text { text: "Site"; color: Theme.fg; font-size: 14px; vertical-alignment: center; }
                        Button {
                            text: setting-is-ex ? "EXHentai" : "E-Hentai";
                            clicked => { root.toggle-site(); }
                        }
                    }
                }

                Rectangle {
                    height: 48px; border-radius: 10px; background: Theme.card;
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px;
                        spacing: 12px;
                        Text { text: ui-language; color: Theme.fg; font-size: 14px; vertical-alignment: center; }
                        Button { text: setting-language; clicked => { root.cycle-language(); } }
                    }
                }

                Text { text: "Network"; color: Theme.fg; font-size: 13px; font-weight: 600; }
                Rectangle {
                    height: 108px; border-radius: 10px; background: Theme.card;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;
                        Text { text: "Proxy (" + setting-proxy-type + ")"; color: Theme.fg-dim; font-size: 12px; }
                        LineEdit {
                            text: setting-proxy-address;
                            placeholder-text: "host:port (empty = system proxy)";
                            edited(text) => { root.set-proxy(text); }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Domain fronting"; color: Theme.fg-dim; font-size: 12px; vertical-alignment: center; }
                            Button {
                                text: setting-domain-fronting ? "On" : "Off";
                                clicked => { root.toggle-domain-fronting(); }
                            }
                        }
                    }
                }

                Text { text: "Reading"; color: Theme.fg; font-size: 13px; font-weight: 600; }
                Rectangle {
                    height: 132px; border-radius: 10px; background: Theme.card;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 8px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Direction"; color: Theme.fg-dim; font-size: 12px; vertical-alignment: center; }
                            Button { text: setting-read-direction; clicked => { root.cycle-read-direction(); } }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Keep screen awake"; color: Theme.fg-dim; font-size: 12px; vertical-alignment: center; }
                            Button { text: setting-keep-awake ? "On" : "Off"; clicked => { root.toggle-keep-awake(); } }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Auto page turn"; color: Theme.fg-dim; font-size: 12px; vertical-alignment: center; }
                            Button { text: setting-auto-turn ? "On" : "Off"; clicked => { root.toggle-auto-turn(); } }
                            Button { text: setting-auto-interval; clicked => { root.cycle-auto-interval(); } }
                        }
                    }
                }

                Text { text: "Download"; color: Theme.fg; font-size: 13px; font-weight: 600; }
                Rectangle {
                    height: 96px; border-radius: 10px; background: Theme.card;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 8px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Concurrency"; color: Theme.fg-dim; font-size: 12px; vertical-alignment: center; }
                            Button { text: setting-download-concurrency; clicked => { root.bump-download-concurrency(); } }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Download original (needs login)"; color: Theme.fg-dim; font-size: 12px; vertical-alignment: center; }
                            Button { text: setting-download-original ? "On" : "Off"; clicked => { root.toggle-download-original(); } }
                        }
                    }
                }

                Text { text: "Security"; color: Theme.fg; font-size: 13px; font-weight: 600; }
                Rectangle {
                    height: 76px; border-radius: 10px; background: Theme.card;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;
                        Text {
                            text: setting-pin-enabled ? "App lock: on (type empty to disable)" : "App lock: off (set 4-8 digits)";
                            color: Theme.fg-dim; font-size: 12px;
                        }
                        LineEdit {
                            placeholder-text: "PIN";
                            edited(text) => { root.set-pin(text); }
                        }
                    }
                }

                Text { text: ui-about; color: Theme.fg; font-size: 13px; font-weight: 600; }
                Rectangle {
                    height: 132px; border-radius: 10px; background: Theme.card;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;
                        Text { text: "JHenTai Rust " + setting-version; color: Theme.fg; font-size: 12px; }
                        Text {
                            text: setting-persistent ? "Data: persisted to db.sqlite" : "Database unavailable - settings and progress are NOT saved";
                            color: setting-persistent ? Theme.fg-dim : Theme.danger;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        // Slint Royalty-free 许可要求：在一处展示 AboutSlint
                        AboutSlint { }
                    }
                }
            }
        }

        // 锁屏（启用 PIN 时覆盖在上面）
        if locked : Rectangle {
            background: Theme.bg;
            VerticalLayout {
                alignment: center;
                spacing: 12px;
                Text { text: "Enter PIN"; color: Theme.fg; font-size: 16px; horizontal-alignment: center; }
                LineEdit {
                    input-type: password;
                    edited(text) => { root.unlock(text); }
                }
            }
        }

        // 下载页（page 3）
        if page == 3 : ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 8px;
                padding: 12px;
                if downloads.length == 0 : Text {
                    text: ui-no-downloads;
                    color: Theme.fg-dim;
                    horizontal-alignment: center;
                }
                for item in downloads : Rectangle {
                    height: 72px;
                    border-radius: 10px;
                    background: Theme.card;
                    clip: true;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;
                        Text {
                            text: item.title;
                            color: Theme.fg;
                            font-size: 14px;
                            overflow: elide;
                        }
                        Rectangle {
                            height: 6px;
                            border-radius: 3px;
                            background: Theme.placeholder;
                            Rectangle {
                                width: parent.width * item.ratio;
                                height: 100%;
                                border-radius: 3px;
                                background: item.status == 3 ? Theme.danger : (item.status == 2 ? #3fb950 : Theme.accent);
                            }
                        }
                        Text {
                            text: item.downloaded + " / " + item.total
                                + (item.status == 1 ? "  downloading…" : item.status == 2 ? "  done" : item.status == 3 ? "  failed" : "");
                            color: Theme.fg-dim;
                            font-size: 11px;
                        }
                    }
                    TouchArea {
                        clicked => { root.open-local-gallery(item.gid); }
                    }
                }
            }
        }

        // 阅读器（page 2）：填满 VerticalBox 剩余空间
        if page == 2 : Rectangle {
            vertical-stretch: 1;
            background: #000000;
            VerticalLayout {
                // 图片区：左右 1/3 翻页、中间返回（覆盖在图片上，但不遮底部工具条）
                Rectangle {
                    vertical-stretch: 1;
                    Image {
                        source: reader-current;
                        width: 100%;
                        height: 100%;
                        image-fit: contain;
                    }
                    HorizontalLayout {
                        Rectangle {
                            horizontal-stretch: 1;
                            background: transparent;
                            TouchArea { clicked => { root.reader-step(-1); } }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            background: transparent;
                            TouchArea { clicked => { root.back(); } }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            background: transparent;
                            TouchArea { clicked => { root.reader-step(1); } }
                        }
                    }
                }

                // 底部工具条
                Rectangle {
                    height: 28px;
                    background: #000000cc;
                    Text {
                        text: (reader-index + 1) + " / " + reader-total;
                        color: #ffffff;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            if reader-error != "" : Text {
                text: reader-error;
                color: Theme.danger;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }

    }
}