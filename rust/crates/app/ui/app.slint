// JHenTai Rust 版主窗口：底部导航 + 画廊列表 + 详情。
// 组件拆分遵循计划 §4.3：每页一个组件 + controller，单 Window + Rust 侧 Navigator。

import { Button, ScrollView, ListView, VerticalBox, HorizontalBox, StandardListView } from "std-widgets.slint";

export struct GalleryItem {
    gid: int,
    title: string,
    category: string,
    cover: image,
    page-count: int,
    rating: float,
    uploader: string,
    publish-time: string,
    language: string,
    favorite-color: color,
    has-rated: bool,
}

export struct ThumbnailItem {
    index: int,
    thumb: image,
    href: string,
    offset: float,
    is-large: bool,
}

export struct LoadState {
    loading: bool,
    error: string,
    prev-gid: string,
    next-gid: string,
    total: string,
}

// 单张卡片：列表模式
component GalleryCard inherits Rectangle {
    in property <GalleryItem> item;
    callback clicked();

    height: 96px;
    border-radius: 12px;
    background: Theme.card;
    clip: true;

    HorizontalLayout {
        padding: 8px;
        spacing: 10px;

        // 封面：保持 3:4 比例，懒加载由 Rust 侧按可见范围喂图
        Rectangle {
            width: 60px;
            border-radius: 6px;
            background: Theme.placeholder;
            clip: true;
            Image {
                source: root.item.cover;
                width: 60px;
                height: 100%;
                image-fit: cover;
            }
        }

        VerticalLayout {
            spacing: 4px;
            alignment: start;

            Text {
                text: root.item.title;
                color: Theme.fg;
                font-size: 14px;
                wrap: word-wrap;
                max-height: 40px;
                overflow: elide;
            }

            HorizontalLayout {
                spacing: 6px;
                Rectangle {
                    width: category-text.preferred-width + 10px;
                    height: 18px;
                    border-radius: 4px;
                    background: root.item.favorite-color;
                    category-text := Text {
                        text: root.item.category;
                        color: #ffffff;
                        font-size: 11px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Text {
                    text: root.item.page-count > 0 ? root.item.page-count + "P" : "";
                    color: Theme.fg-dim;
                    font-size: 11px;
                }
                Text {
                    text: root.item.rating > 0 ? "★ " + Math.round(root.item.rating * 10) / 10 : "";
                    color: Theme.star;
                    font-size: 11px;
                }
            }

            Text {
                text: root.item.uploader;
                color: Theme.fg-dim;
                font-size: 11px;
                overflow: elide;
            }
        }
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

export global Theme {
    in-out property <color> bg: #16161a;
    in-out property <color> card: #232329;
    in-out property <color> fg: #ececf1;
    in-out property <color> fg-dim: #9a9aa5;
    in-out property <color> accent: #6750a4;
    in-out property <color> star: #fcb417;
    in-out property <color> placeholder: #33333c;
    in-out property <color> danger: #e5484d;
}

export component AppWindow inherits Window {
    in-out property <length> safe-area-top: 0px;
    in-out property <length> safe-area-bottom: 0px;

    title: "JHenTai";
    background: Theme.bg;
    preferred-width: 400px;
    preferred-height: 800px;

    // ---- data exposed to Rust ----
    in-out property <[GalleryItem]> galleries: [];
    in-out property <bool> loading: false;
    in-out property <string> error-text: "";
    in-out property <string> total-text: "";
    in-out property <int> current-tab: 0;
    in-out property <bool> can-go-next: false;
    in-out property <bool> can-go-prev: false;
    in-out property <int> page-index: 0;
    in-out property <bool> has-items: galleries.length > 0;

    // ---- details page ----
    in-out property <int> page: 0; // 0 = list, 1 = details
    in-out property <[ThumbnailItem]> detail-thumbnails: [];
    in-out property <[string]> detail-tags: [];
    in-out property <[string]> detail-comments: [];
    in-out property <string> detail-title: "";
    in-out property <string> detail-japanese-title: "";
    in-out property <string> detail-category: "";
    in-out property <color> detail-category-color: Theme.placeholder;
    in-out property <int> detail-pages: 0;
    in-out property <float> detail-rating: 0;
    in-out property <float> detail-real-rating: 0;
    in-out property <int> detail-rating-count: 0;
    in-out property <int> detail-thumbnail-pages: 0;
    in-out property <string> detail-uploader: "";
    in-out property <string> detail-publish-time: "";
    in-out property <string> detail-size: "";
    in-out property <string> detail-language: "";
    in-out property <bool> detail-is-favorite: false;
    in-out property <bool> detail-expunged: false;
    in-out property <bool> detail-loading: false;
    in-out property <string> detail-error: "";

    // ---- callbacks to Rust ----
    callback back();
    callback refresh();
    callback next-page();
    callback prev-page();
    callback open-gallery(int);
    callback select-tab(int);

    VerticalBox {
        // 顶栏
        Rectangle {
            height: 52px + safe-area-top;
            background: Theme.card;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: safe-area-top;
                alignment: space-between;

                if page == 1 : Button {
                    text: "‹ Back";
                    clicked => { root.back(); }
                }
                if page == 0 : Text {
                    text: current-tab == 0 ? "Front Page"
                        : current-tab == 1 ? "Popular"
                        : current-tab == 2 ? "Ranklist"
                        : current-tab == 3 ? "Favorites"
                        : current-tab == 4 ? "Watched" : "History";
                    color: Theme.fg;
                    font-size: 18px;
                    font-weight: 600;
                    vertical-alignment: center;
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: total-text;
                        color: Theme.fg-dim;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    Button {
                        text: "↻";
                        clicked => { root.refresh(); }
                    }
                }
            }
        }

        // 列表区（仅列表页）
        if page == 0 && !has-items : Rectangle {
            VerticalLayout {
                alignment: center;
                spacing: 12px;

                if loading : Text {
                    text: "Loading…";
                    color: Theme.fg-dim;
                    horizontal-alignment: center;
                }

                if !loading && error-text != "" : VerticalLayout {
                    spacing: 12px;
                    Text {
                        text: error-text;
                        color: Theme.danger;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    Button {
                        text: "Retry";
                        clicked => { root.refresh(); }
                    }
                }

                if !loading && error-text == "" : Text {
                    text: "No galleries";
                    color: Theme.fg-dim;
                    horizontal-alignment: center;
                }
            }
        }

        if page == 0 && has-items : ListView {
            for gallery[index] in galleries : GalleryCard {
                item: gallery;
                clicked => { root.open-gallery(index); }
            }
        }

        // 详情页
        if page == 1 : ScrollView {
            VerticalLayout {
                spacing: 12px;
                padding: 12px;

                if detail-loading : Text {
                    text: "Loading…";
                    color: Theme.fg-dim;
                    horizontal-alignment: center;
                }
                if !detail-loading && detail-error != "" : Text {
                    text: detail-error;
                    color: Theme.danger;
                    wrap: word-wrap;
                }

                if !detail-loading && detail-error == "" : VerticalLayout {
                    spacing: 8px;

                    Text {
                        text: detail-title;
                        color: Theme.fg;
                        font-size: 18px;
                        font-weight: 600;
                        wrap: word-wrap;
                    }
                    if detail-japanese-title != "" : Text {
                        text: detail-japanese-title;
                        color: Theme.fg-dim;
                        font-size: 13px;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            width: detail-category-text.preferred-width + 12px;
                            height: 20px;
                            border-radius: 4px;
                            background: detail-category-color;
                            detail-category-text := Text {
                                text: detail-category;
                                color: #ffffff;
                                font-size: 12px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Text { text: detail-pages + "P"; color: Theme.fg-dim; font-size: 12px; vertical-alignment: center; }
                        Text {
                            text: "★ " + Math.round(detail-rating * 10) / 10 + " (" + detail-rating-count + ")";
                            color: Theme.star;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        if detail-expunged : Text {
                            text: "EXPUNGED";
                            color: Theme.danger;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: (detail-uploader == "" ? "unknown" : detail-uploader)
                            + " · " + detail-language + " · " + detail-size + " · " + detail-publish-time;
                        color: Theme.fg-dim;
                        font-size: 12px;
                        wrap: word-wrap;
                    }

                    Text { text: "Tags"; color: Theme.fg; font-size: 14px; font-weight: 600; }
                    for tag-line in detail-tags : Text {
                        text: tag-line;
                        color: Theme.fg-dim;
                        font-size: 12px;
                        wrap: word-wrap;
                    }

                    Text {
                        text: "Thumbnails (" + detail-thumbnail-pages + " pages)";
                        color: Theme.fg;
                        font-size: 14px;
                        font-weight: 600;
                    }
                    // 缩略图：5 列网格，行高按 3:4 比
                    GridLayout {
                        spacing: 8px;
                        for thumb[index] in detail-thumbnails : Rectangle {
                            row: Math.floor(index / 5);
                            col: Math.mod(index, 5);
                            min-width: 48px;
                            min-height: 64px;
                            border-radius: 4px;
                            background: Theme.placeholder;
                            clip: true;
                            Image {
                                source: thumb.thumb;
                                width: 100%;
                                height: 100%;
                                image-fit: cover;
                            }
                        }
                    }

                    if detail-comments.length > 0 : Text {
                        text: "Comments";
                        color: Theme.fg;
                        font-size: 14px;
                        font-weight: 600;
                    }
                    for comment in detail-comments : Text {
                        text: comment;
                        color: Theme.fg-dim;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }
        }

        // 翻页条（仅列表页）
        if page == 0 : Rectangle {
            height: 44px;
            background: Theme.card;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;
                alignment: center;
                Button {
                    text: "‹ Prev";
                    enabled: can-go-prev;
                    clicked => { root.prev-page(); }
                }
                Text {
                    text: "Page " + (page-index + 1);
                    color: Theme.fg-dim;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                Button {
                    text: "Next ›";
                    enabled: can-go-next;
                    clicked => { root.next-page(); }
                }
            }
        }

        // 底部导航（仅列表页）
        if page == 0 : Rectangle {
            height: 56px + safe-area-bottom;
            background: Theme.card;
            HorizontalLayout {
                padding-bottom: safe-area-bottom;
                padding-left: 4px;
                padding-right: 4px;
                spacing: 2px;
                for tab[index] in ["Front", "Popular", "Rank", "Fav", "Watch", "History"] : Rectangle {
                    horizontal-stretch: 1;
                    background: index == current-tab ? Theme.accent : transparent;
                    border-radius: 8px;
                    Text {
                        text: tab;
                        color: Theme.fg;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        clicked => { root.select-tab(index); }
                    }
                }
            }
        }
    }
}
